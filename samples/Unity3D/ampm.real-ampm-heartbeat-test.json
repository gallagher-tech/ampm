{
	"default": {
		"persistence": {
			"launchCommand": "./Build/AMPMUnity.exe",
			"maxMemory": 0,
			"startupTimeout": 0,
			"heartbeatTimeout": 5,
			"restartOnProcessExit": true
		},
		"logging": {
			"file": {
				"filename": "logs/server"
			},
			"eventFile": {
				"filename": "logs/event-{date}.tsv"
			},
			"screenshots": {
				"filename": "logs/capture-{date}.jpg"
			},
			"loggly": {
				"enabled": false
			},
			"mail": {
				"enabled": false
			}
		},
		"customConfig": {
			"attractTimeout": 60,
			"language": "en"
		}
	}
}
